DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-this-password
DASHBOARD_AUTH_SECRET=change-this-long-random-secret
# One-off Thursday seminar; Friday schedules resume the following week.
GHP_FIRST_SEMINAR_DATE=2026-08-20
# Apps Script Web app URL and its matching Script Property secret. They reserve
# seminar seats under a shared Apps Script lock, preventing concurrent overbooking.
GHP_BOOKING_WEB_APP_URL=https://script.google.com/macros/s/your-deployment-id/exec
GHP_BOOKING_SECRET=replace-with-a-long-random-secret
# The OAuth account must have access to the Drive folder configured in Apps Script.
# Apps Script writes each generated template PDF to Certificate Issuance/pdf_file_id.
